# Template for /etc/display/env: the admin app's settings and secrets.
# The real file is mode 640, owner root:displayapp, and is NEVER committed to git.
#
# Create it on the Pi (docs/SETUP.md, "Deploy the app"):
#   sudo mkdir -p /etc/display
#   sudo cp /srv/display/pi/env.example /etc/display/env
#   sudo /srv/display/.venv/bin/python /srv/display/scripts/set_password.py --write /etc/display/env
#   sudo chown root:displayapp /etc/display/env && sudo chmod 640 /etc/display/env
# set_password.py adds ADMIN_PASSWORD_HASH and a random SECRET_KEY below these lines.

DISPLAY_DB=/srv/display/data/display.db
DISPLAY_WEB=/srv/display/web

# The team calendar. In Google Calendar on a computer: Settings → the team's calendar →
# Integrate calendar → "Secret address in iCal format". Anyone who has this link can read
# the calendar, so it goes in this file and nowhere else. Remove the # and paste the link:
# CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/XXXX/private-XXXX/basic.ics

# The photo folder: a Google Drive folder shared as "Anyone with the link can view", and a
# Google Cloud API key for the Drive API. docs/SETUP.md step 5 shows how to make both.
# Remove the #s and paste them:
# DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/XXXX?usp=sharing
# DRIVE_API_KEY=XXXX
